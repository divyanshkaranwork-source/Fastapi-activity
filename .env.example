# Copy to .env and fill in. .env is git-ignored.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# LLM_PROVIDER=mock gives an offline keyword heuristic for tests/demos only (not an LLM)

# Optional: require this key (X-API-Key header) on every API endpoint except /health
# ASSESSMENT_API_KEY=

# Optional tuning (defaults shown)
# ASSESSMENT_DB=data/assessment1.db
# LLM_TEMPERATURE=0
# LLM_MAX_OUTPUT_TOKENS=500
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=3
# MAX_INPUT_CHARS=4000
# MAX_BATCH_ROWS=200
# MAX_UPLOAD_BYTES=2000000
# BATCH_WORKERS=5
# CONFIDENCE_THRESHOLD=0.7
# CORRECTION_EXAMPLES=3
# Prices in USD per 1M tokens (verify against current OpenAI pricing)
# PRICE_INPUT_PER_1M=0.40
# PRICE_OUTPUT_PER_1M=1.60
